@page
@model AppRazor.Pages.Friends.IndexModel

@{
    ViewData["Title"] = "Friends";
    var pageCount = Model.PageCount < 1 ? 1 : Model.PageCount;
}

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h3 mb-0">Friends</h1>
            <div class="text-muted small">
                Totalt i DB: <strong>@Model.DbItemsCount</strong> · Sida <strong>@Model.PageNr</strong> av <strong>@pageCount</strong>
            </div>
        </div>
    </div>

    <form method="get" class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label" for="filter">Sök</label>
                    <input id="filter"
                           class="form-control"
                           type="text"
                           name="filter"
                           value="@Model.Filter"
                           placeholder="Sök på namn eller email..." />
                </div>

                <div class="col-md-2">
                    <label class="form-label" for="pageSize">Per sida</label>
                    <input id="pageSize"
                           class="form-control"
                           type="number"
                           name="pageSize"
                           value="@Model.PageSize"
                           min="1" />
                </div>

                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Sök
                    </button>

                    <a class="btn btn-outline-secondary"
                       asp-page="/Friends/Index">
                        Rensa
                    </a>
                </div>
            </div>

            <!-- När man söker vill man oftast börja på sida 1 -->
            <input type="hidden" name="pageNr" value="1" />
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Namn</th>
                            <th>Email</th>
                            <th class="text-end" style="width: 1%;">Åtgärder</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Friends == null || !Model.Friends.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">
                                    Inga vänner matchade din sökning.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var f in Model.Friends)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@f.FirstName @f.LastName</div>
                                    </td>
                                    <td>
                                        <a class="link-underline link-underline-opacity-0"
                                           href="mailto:@f.Email">
                                            @f.Email
                                        </a>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group" aria-label="Actions">
                                            <a class="btn btn-outline-primary"
                                               asp-page="/Friends/Details"
                                               asp-route-id="@f.FriendId">
                                                Details
                                            </a>
                                            <a class="btn btn-outline-secondary"
                                               asp-page="/Friends/Edit"
                                               asp-route-id="@f.FriendId">
                                                Edit
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <nav class="mt-3" aria-label="Pagination">
        <ul class="pagination justify-content-center mb-0">

            <li class="page-item @(Model.PageNr <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-page="/Friends/Index"
                   asp-route-pageNr="@(Model.PageNr - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-filter="@Model.Filter"
                   aria-label="Föregående">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>

            <li class="page-item disabled">
                <span class="page-link">
                    @Model.PageNr / @pageCount
                </span>
            </li>

            <li class="page-item @(Model.PageNr >= pageCount ? "disabled" : "")">
                <a class="page-link"
                   asp-page="/Friends/Index"
                   asp-route-pageNr="@(Model.PageNr + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-filter="@Model.Filter"
                   aria-label="Nästa">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>

        </ul>
    </nav>

</div>
